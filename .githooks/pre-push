#!/usr/bin/env bash
# 推主仓 origin/main 之前，自动构建并推送产物镜像仓，替代手工 npm run publish:dist。
#
# 镜像仓只给飞书插件市场 clone（主仓太大，clone 会超时），见 scripts/publish-dist.mjs。
set -euo pipefail

remote="${1:-}"
pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then pushing_main=1; fi
done

# 只处理推 origin 的 main；其他远端或功能分支放行。
if [ "$remote" != "origin" ] || [ "$pushing_main" -ne 1 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] 构建产物…"
npm run build

# 产物必须已经在本次提交里，否则镜像仓会发布一份主仓没有的 dist。
if [ -n "$(git status --porcelain -- dist)" ]; then
  echo "[pre-push] dist 与源码不一致，镜像仓可能发布到未入库的产物：" >&2
  git status --short -- dist >&2
  echo "[pre-push] 先 git add dist 并提交（或 amend），再推送。" >&2
  exit 1
fi

echo "[pre-push] 同步产物镜像仓…"
node scripts/publish-dist.mjs
