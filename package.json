{
  "name": "recruitment-poster-sidebar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort",
    "check": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:budget": "node scripts/check-frontend-budget.mjs",
    "lint": "eslint src tests scripts vite.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,mjs}\"",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include='src/domain/**' --test-coverage-include='src/application/**' --test-coverage-include='src/data/**' --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:firefox": "BROWSER=firefox node scripts/browser-smoke.mjs",
    "test:browser:webkit": "BROWSER=webkit node scripts/browser-smoke.mjs",
    "test:browser:matrix": "npm run test:browser && npm run test:browser:firefox && npm run test:browser:webkit",
    "verify:static": "npm run check:architecture && npm run check && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run check:budget",
    "verify": "npm run verify:static && npm run test:browser",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.90.0",
    "@douyinfe/semi-ui": "^2.90.0",
    "@lark-base-open/js-sdk": "^1.0.0",
    "@noble/hashes": "^1.8.0",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.14.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.0"
  }
}
